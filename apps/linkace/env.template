## LinkAce .env for the ePHPm recipe (seeded into the storage volume as
## storage/.env on first start; /app/.env is a symlink to it).
##
## Values set in the container environment (compose.yml `environment:`) take
## precedence over this file — Laravel never overrides a variable that is
## already in the process environment. The lines below exist so that the web
## setup wizard has something to update, and as the fallback for anything the
## environment does not set.

# Replaced with a random key by entrypoint.sh on first start.
APP_KEY=someRandomStringWith32Characters

# The URL under which LinkAce is accessible, e.g. https://links.example.com
APP_URL=http://localhost:8080

## Trusted proxies (same semantics as the official image): the IP(s) of a
## reverse proxy in front of ePHPm, or * to trust the immediate upstream.
TRUSTED_PROXIES=*

## Database — set by compose.yml; the setup wizard rewrites these lines.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=linkace
DB_USERNAME=linkace
DB_PASSWORD=linkace

## Search: "database" uses LinkAce's built-in search (no Meilisearch service).
APP_SEARCH_DRIVER=database
