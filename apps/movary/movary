#!/bin/sh
# Movary's console through the embedded PHP
# (`docker compose exec ephpm movary user:create ...`).
# A generated APPLICATION_SECRET lives in the storage volume (entrypoint.sh);
# `docker compose exec` does not go through the entrypoint, so load it here.
if [ -z "${APPLICATION_SECRET:-}" ] && [ -s /app/storage/.application-secret ]; then
    APPLICATION_SECRET="$(cat /app/storage/.application-secret)"
    export APPLICATION_SECRET
fi
exec ephpm php -d memory_limit=-1 /app/bin/console.php "$@"
