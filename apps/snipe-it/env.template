## Snipe-IT .env for the ePHPm recipe (seeded into the storage volume as
## storage/.env on first start; /app/.env is a symlink to it).
##
## Same variable names as the official image's .env.docker. Values set in the
## container environment (compose.yml `environment:`) take precedence over
## this file — Laravel never overrides a variable that is already in the
## process environment.

APP_ENV=production
APP_DEBUG=false
# Replaced with a random key by entrypoint.sh on first start (or set APP_KEY in the environment).
APP_KEY=ChangeMe
# Must be the address users open Snipe-IT at; the setup wizard checks it.
APP_URL=http://localhost:8080
APP_TIMEZONE='UTC'
APP_LOCALE=en-US
MAX_RESULTS=500

PRIVATE_FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=local_public

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT='3306'
DB_DATABASE=snipeit
DB_USERNAME=snipeit
DB_PASSWORD=snipeit
DB_PREFIX=null
DB_DUMP_PATH='/usr/bin'
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

MAIL_MAILER=log
MAIL_FROM_ADDR=you@example.com
MAIL_FROM_NAME='Snipe-IT'

IMAGE_LIB=gd

SESSION_LIFETIME=12000
EXPIRE_ON_CLOSE=false
ENCRYPT=false
COOKIE_NAME=snipeit_session
COOKIE_DOMAIN=null
SECURE_COOKIES=false
# Set to the proxy's IP(s) (or *) behind a reverse proxy.
APP_TRUSTED_PROXIES=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
